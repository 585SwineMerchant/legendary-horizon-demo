# Copy to `.env.local` and fill in your values.
# Large intro MP4s stay gitignored — see docs/CUTSCENE_MEDIA.md.

# ── Backend: two separate Apps Script projects ──────────────────────────────
#
# 1. Game / save backend
#    Project: https://script.google.com/u/0/home/projects/169bJJY9F6noh0pLWbAZQR6ZUG6S0bvb2Fh4-1IvWV4zEiav9H_ueYfiE/edit
#    Handles: save, load, session_end, exit_ticket, teacher_unlock_quest, teacher_restore_*
VITE_LH_APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_GAME_BACKEND_DEPLOYMENT_ID/exec

# 2. Teacher backend
#    Project: https://script.google.com/home/projects/1iWXX68Bn5JUB_xS0CSvWr6AoOi1uAAJPaHWwXNdz1yK7Jlw-9hkhue0J/edit
#    Handles: submit_quest_of_fate_worksheet (writes to LhQuestOfFate tab)
#    Bundle to deploy: Codex/apps-script/lh_teacher_backend.gs
VITE_LH_TEACHER_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_TEACHER_BACKEND_DEPLOYMENT_ID/exec

# Spreadsheet used by both backends (same Google Sheet):
VITE_LH_SPREADSHEET_ID=your_spreadsheet_id_here

# Set to true to skip remote calls and keep saves local even if URLs above are set:
# VITE_LH_FORCE_SIMULATED_SAVE=false

# ── Optional / advanced ─────────────────────────────────────────────────────

# Show teacher dashboard button in production builds (always visible in dev):
# VITE_LH_TEACHER_DASHBOARD=true

# Intro: uses intro-player.html + intro_davinci.mp4 (local in dev, release CDN in prod).
# VITE_LH_INTRO_CINEMATIC_SRC=assets/intro/intro-player.html
# VITE_LH_INTRO_VIDEO_URL=assets/intro/intro_davinci.web.mp4

# Production: host MP4 on GitHub Release (see docs/CUTSCENE_MEDIA.md), then set:
# VITE_LH_MEDIA_BASE_URL=https://github.com/585swinemerchant/legendary-horizon-demo/releases/download/intro-media-v1/

# Local narration generation only:
# ELEVENLABS_INTRO_VOICE_ID=your_existing_intro_voice_id
# ELEVENLABS_API_KEY=your_local_api_key
# Master Scribe intentionally uses a separate elderly female voice:
# ELEVENLABS_MASTER_SCRIBE_VOICE_ID=your_master_scribe_voice_id
# Oracle intentionally uses a separate ageless feminine voice:
# ELEVENLABS_ORACLE_VOICE_ID=your_oracle_voice_id
